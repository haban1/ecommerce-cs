# ==================== LLM 配置 ====================
# 使用阿里云通义千问 API（推荐）
LLM_MODEL_NAME=qwen-plus
# 阿里云 API 地址
VLLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云 API Key（必须配置）
VLLM_API_KEY=your-dashscope-api-key-here
# 或者使用环境变量名（推荐）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ==================== 本地 vLLM 部署配置（备选方案）====================
# 如果使用本地部署的模型，取消下面的注释并注释掉上面的阿里云配置
# LLM_MODEL_NAME=Qwen1.5-1.8B-customer-service
# VLLM_API_BASE=http://vllm-server:8000/v1
# VLLM_API_KEY=EMPTY

# ==================== Embedding 模型 ====================
# 使用阿里云 Embedding API（推荐，与 DASHSCOPE_API_KEY 共用）
# 无需配置本地模型路径

# 如果使用本地 Embedding 模型（高级用户）
# EMBEDDING_MODEL_PATH=BAAI/bge-large-zh-v1.5
# RERANKER_MODEL_PATH=BAAI/bge-reranker-large

# ==================== MySQL 配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ecommerce_cs

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== API 配置 ====================
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
# 容器内 Gradio 访问 API 时使用；本机运行 Gradio 可不设置
API_BASE_URL=http://api:8080

# ==================== 限流配置 ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==================== 向量数据库配置 ====================
# Chroma 持久化路径
CHROMA_PERSIST_DIR=./data/chroma_db

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ==================== MCP Server 配置 ====================
# 订单服务 MCP Server 端口
ORDER_SERVER_PORT=5001
# RAG 服务 MCP Server 端口
RAG_SERVER_PORT=5002